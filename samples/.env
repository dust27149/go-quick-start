# 该文件用于配置Docker相关参数，支持在`.env`文件中进行自定义配置。
# ====================容器和镜像====================
# 容器名称
CONTAINER_NAME=go-quick-start-samples
# 镜像名称
IMAGE_NAME=go-quick-start-samples
# 镜像标签，默认为latest
IMAGE_TAG=latest

# ====================构建参数====================
# go版本，默认为1.26.5
GO_VERSION=1.26.5
# 目标操作系统和架构，默认为linux/amd64
TARGETOS=linux
# 目标架构，默认为amd64
TARGETARCH=amd64

# 端口映射
# 容器端口，默认为8080
HOST_PORT=8080
# 容器端口，默认为8080
CONTAINER_PORT=8080

# ====================卷映射====================
# 主机配置文件路径，默认为samples目录下的config.json
HOST_CONFIG_PATH=
# 主机日志目录路径，默认为/var/log/go-quick-start-samples
HOST_LOGS_PATH=/var/log/go-quick-start-samples
# 主机数据目录路径，默认为/data/go-quick-start-samples
HOST_DATA_PATH=/data/go-quick-start-samples
